---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Hero } from '@/components/Hero';
import ExperienceSection from '@/components/ExperienceSection.astro';
import ShippedWith from '@/components/ShippedWith.astro';
import AISection from '@/components/AISection.astro';
import WaysToWork from '@/components/WaysToWork.astro';
import SkillsSection from '@/components/SkillsSection.astro';
import { ProjectCard } from '@/components/ProjectCard';
import { projects } from '@/data/projects';
import { site, skills } from '@/data/site';

const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: site.name,
	url: site.url,
	image: site.image,
	email: `mailto:${site.email}`,
	jobTitle: site.role,
	description: site.description,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Porto Alegre',
		addressRegion: 'RS',
		addressCountry: 'BR',
	},
	sameAs: [site.github, site.linkedin],
	knowsAbout: skills.flatMap((s) => s.items),
};
---

<BaseLayout type="profile" jsonLd={personSchema}>
	<main>
		<Hero />

		<ShippedWith />

		<ExperienceSection />

		<AISection />

		<section id="work" aria-labelledby="work-title" class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
			<div class="flex items-baseline justify-between gap-4 mb-10">
				<h2 id="work-title" class="text-3xl sm:text-4xl font-bold tracking-tight">Side projects</h2>
				<a href="/projects" class="text-sm text-muted-foreground hover:text-foreground underline underline-offset-4">All projects →</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				{projects.map((project) => <ProjectCard project={project} headingLevel="h3" />)}
			</div>
		</section>

		<SkillsSection />

		<WaysToWork />

		<section id="contact" aria-labelledby="contact-title" class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 text-center">
			<h2 id="contact-title" class="text-3xl sm:text-4xl font-bold tracking-tight">Let's work together</h2>
			<p class="mt-4 text-lg text-muted-foreground font-light max-w-2xl mx-auto">
				I'm looking for senior full-stack or front-end roles on remote product teams.
				The fastest way to reach me is by email.
			</p>
			<a
				href={`mailto:${site.email}`}
				class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-white text-black font-semibold hover:bg-white/90 transition-colors"
			>
				{site.email}
			</a>
		</section>
	</main>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ProjectCard } from '@/components/ProjectCard';
import { projects } from '@/data/projects';
---

<BaseLayout
	title="Projects"
	description="Side projects by Luiz Almeida, Senior Full-Stack Engineer: Cultiva.ai (Ruby on Rails 8, Hotwire, LLM integration, Stripe) and a real-time Bitcoin strategy monitor (Python, WebSockets)."
>
	<main class="min-h-screen pt-16 pb-16 px-4 sm:px-6 lg:px-8">
		<section class="container mx-auto max-w-6xl mb-16 text-center">
			<h1 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight leading-[1.1] mb-6 [text-shadow:0_4px_12px_rgba(0,0,0,0.4)]">
				Projects
			</h1>
			<p class="text-lg sm:text-xl md:text-2xl font-light text-muted-foreground leading-relaxed max-w-3xl mx-auto">
				Products I build on my own time to explore new ideas end to end
			</p>
		</section>

		<section class="container mx-auto pb-2 max-w-6xl">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</section>
	</main>
</BaseLayout>

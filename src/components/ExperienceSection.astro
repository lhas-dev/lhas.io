---
import { experience, earlierExperience } from '@/data/site';
---

<section id="experience" aria-labelledby="experience-title" class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
	<h2 id="experience-title" class="text-3xl sm:text-4xl font-bold tracking-tight mb-10">Experience</h2>

	<ol class="relative border-l border-border/60 space-y-12 ml-2">
		{experience.map((job) => (
			<li class="pl-8 relative">
				<span class="absolute -left-[7px] top-2 h-3 w-3 rounded-full bg-white ring-4 ring-[#0a0a0a]" aria-hidden="true"></span>

				<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
					<h3 class="text-xl sm:text-2xl font-semibold">
						{job.role} <span class="text-muted-foreground font-normal">at</span>{" "}
						{job.url ? (
							<a href={job.url} target="_blank" rel="noopener noreferrer" class="underline decoration-foreground/30 underline-offset-4 hover:decoration-foreground transition-colors">{job.company}</a>
						) : job.company}
					</h3>
					<p class="text-sm text-muted-foreground whitespace-nowrap">{job.period}</p>
				</div>
				<p class="text-sm text-muted-foreground/80 mt-1">{job.location}</p>

				{job.summary && <p class="mt-3 text-muted-foreground">{job.summary}</p>}

				<ul class="mt-4 space-y-2 list-disc pl-5 marker:text-muted-foreground/60 text-foreground/85 font-light leading-relaxed">
					{job.highlights.map((h) => <li>{h}</li>)}
				</ul>

				{job.caseStudy && (
					<a href={`/work/${job.caseStudy}`} class="mt-4 inline-flex items-center gap-1 text-sm font-medium underline underline-offset-4 hover:text-foreground/80">
						Read the case study →
					</a>
				)}

				<ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
					{job.tags.map((t) => (
						<li class="text-xs px-2 py-1 rounded bg-secondary/70 text-muted-foreground">{t}</li>
					))}
				</ul>
			</li>
		))}
	</ol>

	<div class="mt-12 pl-2">
		<h3 class="text-lg font-semibold mb-3">Earlier</h3>
		<ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-muted-foreground">
			{earlierExperience.map((e) => (
				<li>
					{e.url ? (
						<a href={e.url} target="_blank" rel="noopener noreferrer" class="text-foreground/90 underline decoration-foreground/20 underline-offset-4 hover:decoration-foreground transition-colors">{e.company}</a>
					) : <span class="text-foreground/90">{e.company}</span>} · {e.role}
					<span class="text-muted-foreground/70"> ({e.period})</span>
				</li>
			))}
		</ul>
	</div>
</section>

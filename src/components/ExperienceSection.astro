---
import { experience, earlierExperience } from '@/data/site';

// Most recent year of each role (its end year, or the current year if it is ongoing),
// shown by the big scrolling year next to the timeline. The newest role comes first.
const endYear = (period: string) =>
	/present|current|now/i.test(period)
		? String(new Date().getFullYear())
		: (period.match(/\d{4}/g)?.pop() ?? '');
const firstYear = endYear(experience[0]?.period ?? '');
const digits = [...'0123456789'];

// Roles at companies based outside Brazil get a small, quiet badge (country = last part of the location).
const countryOf = (location: string) => location.split(',').pop()?.trim() ?? '';
const isInternational = (location: string) => countryOf(location) !== 'BR';
---

<section id="experience" aria-labelledby="experience-title" class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
	<h2 id="experience-title" class="text-3xl sm:text-4xl font-bold tracking-tight mb-10">Experience</h2>

	<div class="relative ml-2" data-timeline>
	<!-- Big, faint year that follows the scroll and rolls (odometer-style) to the year of the role in view. -->
	<div aria-hidden="true" class="timeline-year-wrap pointer-events-none absolute inset-y-0 right-0 hidden sm:block">
		<div class="sticky top-[22vh]">
			<div
				data-timeline-year
				class="timeline-year font-[family-name:var(--font-heading)] font-bold tabular-nums leading-none tracking-tighter text-[7rem] lg:text-[11rem] opacity-[0.12] will-change-transform"
			>
				{[...firstYear].map((d, i) => (
					<span class="odo-col">
						<span class="odo-strip" data-odo-digit style={`transform: translateY(-${Number(d)}em); transition-delay: ${i * 60}ms;`}>
							{digits.map((n) => <span>{n}</span>)}
						</span>
					</span>
				))}
			</div>
		</div>
	</div>
	<!-- Progress line: fills as you scroll through the timeline (script below). Full by default without JS. -->
	<div
		aria-hidden="true"
		data-timeline-bar
		class="pointer-events-none absolute left-0 top-0 bottom-0 z-[1] w-px origin-top bg-gradient-to-b from-emerald-400 via-cyan-400 to-violet-400 shadow-[0_0_8px_rgba(52,211,153,0.6)] transition-transform duration-150 ease-out"
	></div>
	<ol class="relative border-l border-border/60 space-y-12">
		{experience.map((job) => (
			<li class="pl-8 relative" data-year={endYear(job.period)}>
				<span
					data-timeline-dot
					data-active="true"
					class="absolute z-[2] -left-[7px] top-2 h-3 w-3 rounded-full ring-4 ring-[#0a0a0a] bg-muted-foreground/40 transition-all duration-300 data-[active=true]:bg-emerald-400 data-[active=true]:shadow-[0_0_10px_rgba(52,211,153,0.8)]"
					aria-hidden="true"
				></span>

				<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
					<h3 class="text-xl sm:text-2xl font-semibold">
						{job.role} <span class="text-muted-foreground font-normal">at</span>{" "}
						{job.url ? (
							<a href={job.url} target="_blank" rel="noopener noreferrer" class="psy-link underline underline-offset-4">{job.company}</a>
						) : job.company}
					</h3>
					<p class="text-sm text-muted-foreground whitespace-nowrap">{job.period}</p>
				</div>
				<p class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm text-muted-foreground/80">
					<span>{job.location}</span>
					{isInternational(job.location) && (
						<span class="inline-flex items-center gap-1 rounded-full border border-cyan-400/20 bg-cyan-400/[0.06] px-2 py-0.5 text-[11px] font-medium uppercase tracking-wider text-cyan-200/70">
							<svg aria-hidden="true" viewBox="0 0 16 16" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="1.3">
								<circle cx="8" cy="8" r="6.25" />
								<path d="M1.75 8h12.5M8 1.75c1.7 1.8 2.6 3.9 2.6 6.25S9.7 12.45 8 14.25M8 1.75C6.3 3.55 5.4 5.65 5.4 8s.9 4.45 2.6 6.25" />
							</svg>
							{countryOf(job.location)} company
						</span>
					)}
				</p>

				{job.summary && <p class="mt-3 text-muted-foreground">{job.summary}</p>}

				<ul class="mt-4 space-y-2 list-disc pl-5 marker:text-muted-foreground/60 text-foreground/85 font-light leading-relaxed">
					{job.highlights.map((h) => <li>{h}</li>)}
				</ul>

				{job.caseStudy && (
					<a href={`/work/${job.caseStudy}`} class="psy-link mt-4 inline-flex items-center gap-1 text-sm font-medium underline underline-offset-4">
						Read the case study →
					</a>
				)}

				<ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
					{job.tags.map((t) => (
						<li class="psy-chip text-xs px-2 py-1 rounded bg-secondary/70 text-muted-foreground">{t}</li>
					))}
				</ul>
			</li>
		))}
	</ol>
	</div>

	<div class="mt-12 pl-2">
		<h3 class="text-lg font-semibold mb-3">Earlier</h3>
		<ul class="grid sm:grid-cols-2 gap-x-8 gap-y-2 text-muted-foreground">
			{earlierExperience.map((e) => (
				<li>
					{e.url ? (
						<a href={e.url} target="_blank" rel="noopener noreferrer" class="psy-link text-foreground/90 underline underline-offset-4">{e.company}</a>
					) : <span class="text-foreground/90">{e.company}</span>} · {e.role}
					<span class="text-muted-foreground/70"> ({e.period})</span>
				</li>
			))}
		</ul>
	</div>
</section>

<script>
	// Fill the timeline line and light up each dot as it crosses ~60% of the viewport height.
	const root = document.querySelector<HTMLElement>("[data-timeline]");
	const bar = root?.querySelector<HTMLElement>("[data-timeline-bar]");
	const dots = root ? [...root.querySelectorAll<HTMLElement>("[data-timeline-dot]")] : [];
	const yearEl = root?.querySelector<HTMLElement>("[data-timeline-year]");
	const digitStrips = yearEl ? [...yearEl.querySelectorAll<HTMLElement>("[data-odo-digit]")] : [];
	let shownYear = "";

	const showYear = (year: string) => {
		if (!year || year === shownYear) return;
		shownYear = year;
		[...year].forEach((d, i) => {
			if (digitStrips[i]) digitStrips[i].style.transform = `translateY(-${Number(d)}em)`;
		});
	};

	if (root && bar) {
		let ticking = false;
		const update = () => {
			ticking = false;
			const anchor = window.innerHeight * 0.6;
			const rect = root.getBoundingClientRect();
			const progress = Math.min(1, Math.max(0, (anchor - rect.top) / rect.height));
			bar.style.transform = `scaleY(${progress})`;
			let activeYear = "";
			for (const dot of dots) {
				const d = dot.getBoundingClientRect();
				const active = d.top + d.height / 2 <= anchor;
				dot.dataset.active = String(active);
				if (active) activeYear = dot.closest<HTMLElement>("[data-year]")?.dataset.year ?? activeYear;
			}
			showYear(activeYear || dots[0]?.closest<HTMLElement>("[data-year]")?.dataset.year || "");
			// Gentle drift so the year feels like it travels with the scroll.
			if (yearEl) yearEl.style.transform = `translateY(${(progress - 0.5) * -80}px)`;
		};
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};
		update();
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
	}
</script>

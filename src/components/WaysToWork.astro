---
import { engagements, site } from '@/data/site';
---

<section id="work-with-me" aria-labelledby="work-with-me-title" class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16">
	<h2 id="work-with-me-title" class="text-3xl sm:text-4xl font-bold tracking-tight">Ways to work with me</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		{engagements.map((e) => (
			<article class="psy-card flex flex-col rounded-xl border border-border/60 bg-secondary/20 p-6">
				<h3 class="text-lg font-semibold">{e.title}</h3>
				<dl class="mt-4 space-y-4 text-sm">
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/70">What you get</dt>
						<dd class="mt-1 font-light leading-relaxed text-foreground/85">{e.whatYouGet}</dd>
					</div>
					<div>
						<dt class="text-xs font-semibold uppercase tracking-wider text-muted-foreground/70">Good fit</dt>
						<dd class="mt-1 font-light leading-relaxed text-foreground/85">{e.goodFit}</dd>
					</div>
				</dl>
			</article>
		))}
	</div>

	<div class="psy-card mt-8 rounded-xl border border-border/60 p-6 grid gap-4 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-8">
		<p class="text-2xl font-bold tracking-tight font-[family-name:var(--font-heading)]">{site.timezone}</p>
		<p class="font-light leading-relaxed text-muted-foreground">
			Based in Porto Alegre, Brazil, working remotely across LatAm and the US.
			My time zone works with <span class="text-foreground">EST, CST and PST</span>: 1–2 hours ahead of US Eastern,
			2–3 ahead of Central and 4–5 ahead of Pacific, so we share most of the working day.
		</p>
	</div>
</section>
